# External dataset paths (server-specific, not committed)
FMA_METADATA_DIR=/path/to/fma_metadata
FMA_SMALL_DIR=/path/to/fma_small
MTG_JAMENDO_ROOT=/path/to/mtg-jamendo-dataset
MY_TRACKS_DIR=/path/to/my_tracks

# Audio output directory (defaults to backend/data/audio_fma)
# AUDIO_OUTPUT_DIR=/path/to/output

# Flask settings
FLASK_APP=backend.server
FLASK_ENV=development

# CUDA device for preprocessing (e.g. cuda:0, cuda:1, cpu)
# CUDA_DEVICE=cuda:0

# Security defaults. Keep collection and destructive UI operations closed
# unless you are deliberately running them.
EVAL_COLLECTION_OPEN=false
MUTATIONS_ENABLED=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
